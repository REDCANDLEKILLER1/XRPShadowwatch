{
  "functions": {
    "api/evidence.js": { "maxDuration": 300, "includeFiles": "src/{brief,shared}/**" },
    "api/report-archive.js": { "maxDuration": 60 },
    "api/watchlist-promote.js": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/report/",
      "destination": "/report",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ladyk",
      "destination": "/ladyk.html"
    },
    {
      "source": "/lady-k",
      "destination": "/ladyk.html"
    },
    {
      "source": "/report",
      "destination": "/index.html"
    }
  ]
}
