{
  "functions": {
    "api/evidence.js": {
      "maxDuration": 300,
      "includeFiles": "src/{brief,shared}/**"
    },
    "api/delta.js": {
      "maxDuration": 300,
      "includeFiles": "src/{brief,shared}/**"
    },
    "api/evidence-scheduler.js": {
      "maxDuration": 300,
      "includeFiles": "src/{db,brief,shared}/**"
    },
    "api/report-archive.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/evidence-scheduler",
      "schedule": "5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/report/",
      "destination": "/report",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ladyk",
      "destination": "/ladyk.html"
    },
    {
      "source": "/lady-k",
      "destination": "/ladyk.html"
    },
    {
      "source": "/report",
      "destination": "/index.html"
    }
  ]
}
