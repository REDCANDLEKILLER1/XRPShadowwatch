  for(const e of Object.values(graph.edges)){if(e.source===n.id)out.push(e);if(e.target===n.id)inn.push(e)}
  $('#flowSummary').innerHTML=`<span>Outbound links</span><b>${out.length}</b><span>Outbound XRP</span><b>${fmt(out.reduce((s,e)=>s+(e.totalXRP||0),0))}</b><span>Inbound links</span><b>${inn.length}</b><span>Inbound XRP</span><b>${fmt(inn.reduce((s,e)=>s+(e.totalXRP||0),0))}</b>`;
  const list=$('#edgeList');list.innerHTML='';
  [...out,...inn].sort((a,b)=>(b.totalXRP||0)-(a.totalXRP||0)).slice(0,120).forEach(e=>{
    const other=e.source===n.id?e.target:e.sour