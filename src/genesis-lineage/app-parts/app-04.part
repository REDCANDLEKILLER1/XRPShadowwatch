tedIndex+1)%sel.options.length;
  log(`Auto-connect failover → ${sel.value}.`,'WARN');
}
function scheduleReconnect(reason='disconnected'){
  if(!autoConnectWanted)return;
  clearTimeout(reconnectTimer);
  reconnectAttempt++;
  if(reconnectAttempt>1 && reconnectAttempt%3===0)rotateEndpoint();
  const delay=Math.min(15000,700*Math.pow(1.65,Math.min(reconnectAttempt,8)));
  setConnectionUi('reconnecting','XRPL RECONNECT');
  reconnectTimer=setTimeout(()=>{
    connect().catch(e=>{
      log(`Auto-connect retry failed: ${e.message}`,'WARN');
      scheduleReconnect(e.message);
    });
  },delay);
}
function connect(){
  if(ws&&ws.readyState===WebSocket.OPEN)return Promise.resolve();
  if(connectPromise)return connectPromise;
  const url=$('#server').value;
  setConnectionUi('reconnecting','XRPL CONNECTING');
  log(`Auto-connecting ${url}...`);
  connectPromise=new Promise((resolve,reject)=>{
    let socket,settled=false;
    try{socket=new WebSocket(url)}catch(e){connectPromise=null;return reject(e)}
    ws=socket;
    const timer=setTimeout(()=>{
      if(settled)return;
      settled=true;connectPromise=null;
      try{socket.close()}catch{}
      reject(new Error('connect timeout'));
    },15000);
    socket.onopen=()=>{
      if(settled)return;
      settled=true;clearTimeout(timer);connectPromise=null;reconnectAttempt=0;
      setConnectionUi('connected','XRPL LIVE');
      log(`Auto-connected ${url}.`);
      resolve();
    };
    socket.onclose=()=>{
      clearTimeout(timer);
      if(ws===socket)ws=null;
      connectPromise=null;
      rejectLegacyPending('WebSocket disconnected');
      setConnectionUi('reconnecting','XRPL RECONNECT');
      log('XRPL WebSocket disconnected; automatic reconnect scheduled.','WARN');
      if(autoConnectWanted)scheduleReconnect('socket closed');
      if(!settled){settled=true;reject(new Error('WebSocket closed during connect'))}
    };
    socket.onerror=()=>{
      clearTimeout(timer);
      if(!settled){settled=true;connectPromise=null;reject(new Error('WebSocket error'))}
    };
    socket.onmessage=e=>{
      let m;try{m=JSON.parse(e.data)}catch{return}
      const p=pending.get(m.id);if(!p)return;
      pending.delete(m.id);clearTimeout(p.timer);
      if(m.status==='error'||m.error)p.reject(new Error(m.error_message||m.error||'RPC error'));
      else p.resolve(m.result);
    };
  });
  return connectPromise;
}
function startKeepAlive(){
  clearInterval(keepAliveTimer);
  keepAliveTimer=setInterval(async()=>{
    if(document.hidden)return;
    try{
      if(!ws||ws.readyState!==WebSocket.OPEN){await connect();return}
      await rpc({command:'server_info'},12000);
      setConnectionUi('connected','XRPL LIVE');
    }catch(e){
      log(`XRPL keepalive failed: ${e.message}`,'WARN');
      try{ws&&ws.close()}catch{}
    }
  },30000);
}

function rpc(req,timeout=35000){
  return new Promise((resolve,reject)=>{
    if(!ws||ws.readyState!==WebSocket.OPEN)return reject(new Error('not connected'));
    const id=rpcId++;
    const timer=setTimeout(()=>{if(pending.has(id)){pending.delete(id);reject(new Error('RPC timeout'))}},timeout);
    pending.set(id,{resolve,reject,timer});
    try{ws.send(JSON.stringify({id,command:req.command,...req}))}
    catch(e){clearTimeout(timer);pending.delete(id);reject(e)}
  });
}
async function rpcRetry(req,tries=5){
  let last;
  for(let i=0;i<tries;i++){
    try{await connect();return await rpc(req)}
    catch(e){
      last=e;
      const retryable=retryableWorkerError(e);
      log(`${req.command} attempt ${i+1}/${tries} failed: ${e.message}${retryable?'':' [deterministic]'}`,'WARN');
      if(!retryable||i===tries-1)break;
      try{ws&&ws.close()}catch{}
      await new Promise(r=>setTimeout(r,Math.min(12000,800*2**i)));
    }
  }
  throw last||new Error('RPC failed');
}
function retryableWorkerError(err){
  const m=String(err?.message||err||'').toLowerCase();
  if(/actnotfound|invalid|malformed|badrequest|not supported|unknown command|permission/.test(m))return false;
  return /timeout|websocket|socket|closed|disconnect|network|tempor|busy|overload|server|connection|not connected/.test(m);
}
class WorkerRpcClient{
  constructor(workerId,url){
    this.workerId=workerId;this.url=url;this.ws=null;this.connectPromise=null;
    this.id=1;this.pending=new Map();this.closedByUs=false;
  }
  log(msg,kind='INFO'){log(`ISO-W${this.workerId} ${msg}`,kind)}
  async connect(){
    if(this.ws&&this.ws.readyState===WebSocket.OPEN)return;
    if(this.connectPromise)return this.connectPromise;
    this.closedByUs=false;
    this.connectPromise=new Promise((resolve,reject)=>{
      let settled=false;
      let socket;
      try{socket=new WebSocket(this.url)}catch(e){this.connectPromise=null;return reject(e)}
      this.ws=socket;
      const timer=setTimeout(()=>{
        if(settled)return;settled=true;
        try{socket.close()}catch{}
        this.connectPromise=null;
        reject(new Error('connect timeout'));
      },15000);
      socket.onopen=()=>{
        if(settled)return;settled=true;clearTimeout(timer);
        this.connectPromise=null;this.log(`connected ${this.url}`);
        resolve();
      };
      socket.onmessage=e=>{
        let m;try{m=JSON.parse(e.data)}catch{return}
        const p=this.pending.get(m.id);if(!p)return;
        this.pending.delete(m.id);clearTimeout(p.timer);
        if(m.status==='error'||m.error)p.reject(new Error(m.error_message||m.error||'RPC error'));
        else p.resolve(m.result);
      };
      socket.onerror=()=>{
        if(!settled){settled=true;clearTimeout(timer);this.connectPromise=null;reject(new Error('WebSocket error'))}
      };
      socket.onclose=()=>{
        clearTimeout(timer);this.connectPromise=null;
        for(const [id,p] of this.pending){clearTimeout(p.timer);p.reject(new Error('WebSocket closed'))}
        this.pending.clear();
        if(!this.closedByUs)this.log('socket disconnected','WARN');
      };
    });
    return this.connectPromise;
  }
  async rpc(req,timeout=40000){
    await this.connect();
    return new Promise((resolve,reject)=>{
      if(!this.ws||this.ws.readyState!==WebSocket.OPEN)return reject(new Error('not connected'));
      const id=this.id++;
      const timer=setTimeout(()=>{
        if(this.pending.has(id)){this.pending.delete(id);reject(new Error('RPC timeout'))}
      },timeout);
      this.pending.set(id,{resolve,reject,timer});
      try{this.ws.send(JSON.stringify({id,command:req.command,...req}))}
      catch(e){clearTimeout(timer);this.pending.delete(id);reject(e)}
    });
  }
  async rpcRetry(req,tries=5){
    let last;
    for(let i=0;i<tries;i++){
      try{return await this.rpc(req)}
      catch(e){
        last=e;
        const retryable=retryableWorkerError(e);
        this.log(`${req.command} attempt ${i+1}/${tries} failed: ${e.message}${retryable?'':' [deterministic]'}`,'WARN');
        if(!retryable||i===tries-1)break;
        await this.reset();
        await new Promise(r=>setTimeout(r,Math.min(8000,500*2**i)));
      }
    }
    throw last||new Error('RPC failed');
  }
  async reset(){
    const old=this.ws;
    this.closedByUs=true;
    this.ws=null;this.connectPromise=null;
    if(old){try{old.close()}catch{}}
    await new Promise(r=>setTimeout(r,40));
    this.closedByUs=false;
  }
  close(){
    this.closedByUs=true;
    if(this.ws){try{this.ws.close()}catch{}}
    this.ws=null;this.connectPromise=null;
    for(const [id,p] of this.pending){clearTimeout(p.timer);p.reject(new Error('worker closed'))}
    this.pending.clear();
  }
}
function txObj(item){return item.tx||item.tx_json||item}
function txMeta(item){return item.meta||item.metaData||{}}
function successful(item){
  const r=txMeta(item).TransactionResult;
  return !r || r==='tesSUCCESS';
}
