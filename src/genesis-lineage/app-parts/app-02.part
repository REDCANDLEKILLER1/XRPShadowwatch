  const n=Object.keys(graph.nodes||{}).length,e=Object.keys(graph.edges||{}).length;
  const hn=Number(manifest?.coverage?.graphNodes||0),he=Number(manifest?.coverage?.graphEdges||0);
  if(n>=hn&&e>=he)return false;
  setHubUi('syncing','HUB GRA